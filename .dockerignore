# Dependencies (reinstalled from lockfile inside the image)
node_modules

# Build outputs and caches (regenerated by `npm run build`)
build
.cache
.react-router
.vite

# Version control and CI
.git
.gitignore

# Environment and secrets (must never enter the image)
.env
.env.*

# Local tooling / agent state
.apo
.claude
.opencode
.pi
.pi-lens
.aider*
handoff

# Editor / OS cruft
.DS_Store
*.log

# Tests and docs (not needed at runtime)
coverage
docs
*.md
!README.md
